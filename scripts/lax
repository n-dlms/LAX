#!/usr/bin/env bash
set -euo pipefail

BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${BOLD}LAX — Keep Your Position Safe${NC}"
echo "Boot sequence..."
echo ""

error=0

check_cmd() {
  local cmd=$1
  local hint=$2
  if ! command -v "$cmd" &>/dev/null; then
    echo -e "  ${RED}✗${NC} $cmd not found. $hint"
    return 1
  fi
  echo -e "  ${GREEN}✓${NC} $cmd"
  return 0
}

check_cmd anvil "Install Foundry: curl -L https://foundry.paradigm.xyz | bash && foundryup"
check_cmd cast "Install Foundry: curl -L https://foundry.paradigm.xyz | bash && foundryup"
check_cmd node "Install Node 20+: https://nodejs.org"
check_cmd npm "Comes with Node"
check_cmd kh "Install kh CLI: download from https://github.com/KeeperHub/cli/releases"
check_cmd npx "Comes with Node"

[ -f .env ] || { echo -e "  ${RED}✗${NC} .env file not found. cp .env.example .env"; error=1; }

if [ -f .env ]; then
  set -a
  source .env
  set +a

  [ -n "${KEEPERHUB_API_KEY:-}" ] || { echo -e "  ${YELLOW}⚠${NC} KEEPERHUB_API_KEY not set in .env"; }
  [ -n "${BASE_RPC_URL:-}" ] || { echo -e "  ${YELLOW}⚠${NC} BASE_RPC_URL not set in .env"; }
  [ -n "${SEPOLIA_RPC_URL:-}" ] || { echo -e "  ${YELLOW}⚠${NC} SEPOLIA_RPC_URL not set in .env"; }
fi

echo ""

TSX_CMD="npx tsx"
if [ -f node_modules/tsx/dist/cli.mjs ]; then
  TSX_CMD="node node_modules/tsx/dist/cli.mjs"
fi

if ! $TSX_CMD -e "
  import { CONFIG, validateConfig } from './src/config';
  const errors = validateConfig();
  if (errors.length) { errors.forEach(e => console.error(e)); process.exit(1); }
  console.log('Config validated: HF', CONFIG.HF.HEALTHY, '→', CONFIG.HF.TRIGGER);
" 2>&1; then
  echo -e "${RED}Config validation failed${NC}"
  error=1
fi

echo ""

echo -e "${BOLD}Prerequisite check complete.${NC}"
echo ""
echo "Start the demo:"
echo "  1. tmux (or 4 terminals)"
echo "  2. ./scripts/start-fork.sh"
echo "  3. ./scripts/fork-setup-usdc.sh"
echo "  4. npx tsx scripts/hf-listener.ts"
echo "  5. cd src/dashboard && npx vite --host 127.0.0.1"
echo ""
echo "Or run: ./scripts/lax (prerequisite check)"
echo ""

exit $error