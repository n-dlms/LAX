# Dashboard env (copy to dashboard/.env)
# Webhook key (wfb_*) — REQUIRED for firing the workflow from the browser.
# The org key (kh_*) is rejected by the webhook endpoint (wrong_key_type).
VITE_KEEPERHUB_WEBHOOK_KEY=wfb_your_webhook_key_here
# Optional fallback / read-only org key
VITE_KEEPERHUB_API_KEY=kh_your_org_key_here
