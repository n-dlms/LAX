{
  "$schema": "https://opencode.ai/schemas/opencode.json",
  "agent": {
    "lax-guardian": {
      "prompt": "agent/SYSTEM_PROMPT.md",
      "skills": [
        "agent/skills/monitor-health-factor.md",
        "agent/skills/trigger-mitigation.md",
        "agent/skills/fund-position.md"
      ]
    }
  },
  "mcp": {
    "keeperhub": {
      "type": "remote",
      "url": "https://app.keeperhub.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:KEEPERHUB_API_KEY}"
      }
    },
    "lax-liquidation-armor": {
      "type": "remote",
      "url": "https://app.keeperhub.com/mcp/w/lax-liquidation-armor",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:KEEPERHUB_API_KEY}"
      }
    }
  }
}
