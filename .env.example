# LAX environment — copy to `.env` and fill in (`.env` is gitignored, never commit it)

# ── KeeperHub (required for the live webhook path) ─────────────────────────
# Org API key from app.keeperhub.com → Settings → API keys (starts with kh_)
KEEPERHUB_API_KEY=kh_your_org_key_here
# Webhook key for firing workflows (starts with wfb_) — Settings → API keys.
# Falls back to KEEPERHUB_API_KEY, but workflow webhooks require the wfb_ type.
KEEPERHUB_WEBHOOK_KEY=wfb_your_webhook_key_here

# ── RPC endpoints ───────────────────────────────────────────────────────────
# Fork source for the local demo (public endpoint is fine, no key needed)
BASE_RPC_URL=https://mainnet.base.org
# Live-testnet path for real submissions (any Base Sepolia RPC)
SEPOLIA_RPC_URL=https://sepolia.base.org

# ── Positions & workflows ───────────────────────────────────────────────────
# Workflow that executes approve → repay when the daemon fires (from deploy-workflow*.sh output)
LAX_WORKFLOW_ID_SEPOLIA=your_sepolia_workflow_id
# The address whose position the autopilot defends (defaults to your own wallet)
LAX_BORROWER_ADDRESS=0x0000000000000000000000000000000000000000

# ── Optional overrides (sensible defaults exist) ────────────────────────────
# LAX_ALERT_WEBHOOK=                    # Discord/Slack webhook — alerts on trigger/block/fire/failure
# LAX_WALLET_ADDRESS=0x...            # executing wallet (else ~/.keeperhub/wallet.json → config)
# LAX_SELF_DEFENSE=true               # wallet defends its own position
# LAX_FORK_RPC=http://127.0.0.1:18545 # local fork RPC
# LAX_BLOCK_THRESHOLD_USD=50          # per-tx spend cap (default 10)
# LAX_DAILY_LIMIT_USD=100             # daily spend cap (default 5)
# LAX_CONFIG_PATH=lax.config.json     # multi-position config location
