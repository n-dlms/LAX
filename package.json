{
  "name": "lax",
  "version": "2.0.0",
  "private": true,
  "description": "LAX — proactive Aave V3 liquidation defender: Liquidation CLI + autopilot daemon on KeeperHub",
  "type": "module",
  "bin": {
    "lax": "bin/lax.ts"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "demo": "bash scripts/demo-up.sh",
    "lax": "tsx bin/lax.ts",
    "dev": "bash scripts/lax",
    "fire": "bash scripts/fire-sepolia.sh",
    "dry-run": "bash scripts/dry-run.sh",
    "fork:start": "bash scripts/start-fork.sh",
    "fork:stop": "bash scripts/fork-shutdown.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "lint:dashboard": "tsc --noEmit -p dashboard",
    "build": "npm run build --prefix dashboard"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@keeperhub/wallet": "^0.1.15",
    "ethers": "^6.17.0",
    "tsx": "^4.19.0"
  }
}
